Group               groupItemAC1_PT_corridoio   "Climatizzatore Corridoio PT"   <climate>       (Corridoio)                 ["Equipment", "HVAC"]

Switch              AC1_Power                   "Power"                         <switch>        (groupItemAC1_PT_corridoio) ["Control", "Switch"]           { channel="gree:airconditioner:502cc6xxxxxx:power" }
String              AC1_Mode                    "Modalità"                      <text>          (groupItemAC1_PT_corridoio) ["Control"]                     { channel="gree:airconditioner:502cc6xxxxxx:mode" }
Number:Temperature  AC1_Temperature             "Target [%.1f °C]"              <temperature>   (groupItemAC1_PT_corridoio) ["Setpoint", "Temperature"]     { channel="gree:airconditioner:502cc6xxxxxx:temperature" }
Number:Temperature  AC1_CurrentTemperature      "Attuale [%.1f °C]"             <temperature>   (groupItemAC1_PT_corridoio) ["Measurement", "Temperature"]  { channel="gree:airconditioner:502cc6xxxxxx:currentTemperature" }
Switch              AC1_Air                     "Air"                                           (groupItemAC1_PT_corridoio)                                 { channel="gree:airconditioner:502cc6xxxxxx:air" }
Switch              AC1_Dry                     "Dry"                                           (groupItemAC1_PT_corridoio)                                 { channel="gree:airconditioner:502cc6xxxxxx:dry" }
Switch              AC1_Turbo                   "Turbo"                                         (groupItemAC1_PT_corridoio)                                 { channel="gree:airconditioner:502cc6xxxxxx:turbo" }
Number              AC1_WindSpeed               "Ventola"                                       (groupItemAC1_PT_corridoio) ["Control"]                     { channel="gree:airconditioner:502cc6xxxxxx:windspeed", stateDescription=""[pattern="%s", options="0=Auto,1=Bassa,2=Medio-bassa,3=Media,4=Medio-alta,5=Alta"] }
//Number              AC1_WindSpeed               "Ventola [%d]"                                  (groupItemAC1_PT_corridoio) ["Control"]                     { channel="gree:airconditioner:502cc6xxxxxx:windspeed" }
String              AC1_Quiet                   "Quiet"                         <text>          (groupItemAC1_PT_corridoio)                                 { channel="gree:airconditioner:502cc6xxxxxx:quiet" }
Number              AC1_SwingUpDown             "Swing V"                                       (groupItemAC1_PT_corridoio)                                 { channel="gree:airconditioner:502cc6xxxxxx:swingUpDown", stateDescription=""[pattern="%s", options="0=Off,1=Completa,2=Su,3=Medio-alto,4=Medio,5=Medio-basso,6=Giù"] }
//Number              AC1_SwingUpDown             "Swing V [%d]"                                  (groupItemAC1_PT_corridoio)                                 { channel="gree:airconditioner:502cc6xxxxxx:swingUpDown" }
Number              AC1_SwingLeftRight          "Swing H"                                       (groupItemAC1_PT_corridoio)                                 { channel="gree:airconditioner:502cc6xxxxxx:swingLeftRight", stateDescription=""[pattern="%s", options="0=Off,1=Completa,2=Sinistra,3=Medio-sinistra,4=Medio,5=Medio-destra,6=Destra"] }
//Number              AC1_SwingLeftRight          "Swing H [%d]"                                  (groupItemAC1_PT_corridoio)                                 { channel="gree:airconditioner:502cc6xxxxxx:swingLeftRight" }
Switch              AC1_PowerSave               "Power Save"                                    (groupItemAC1_PT_corridoio)                                 { channel="gree:airconditioner:502cc6xxxxxx:powersave" }
Switch              AC1_Light                   "Display"                                       (groupItemAC1_PT_corridoio)                                 { channel="gree:airconditioner:502cc6xxxxxx:light" }
Switch              AC1_Health                  "Health"                                        (groupItemAC1_PT_corridoio)                                 { channel="gree:airconditioner:502cc6xxxxxx:health" }




