Group               groupItemAC1_room1          "AirConditioner Room1"          <climate>       (Room1)              ["Equipment", "HVAC"]

Switch              AC1_Power                   "Power"                         <switch>        (groupItemAC1_room1) ["Control", "Switch"]           { channel="gree:airconditioner:502cc6XXXXXX:power" }
String              AC1_Mode                    "Modalità"                      <text>          (groupItemAC1_room1) ["Control"]                     { channel="gree:airconditioner:502cc6XXXXXX:mode" }
Number:Temperature  AC1_Temperature             "Target [%.1f °C]"              <temperature>   (groupItemAC1_room1) ["Setpoint", "Temperature"]     { channel="gree:airconditioner:502cc6XXXXXX:temperature" }
Number:Temperature  AC1_CurrentTemperature      "Attuale [%.1f °C]"             <temperature>   (groupItemAC1_room1) ["Measurement", "Temperature"]  { channel="gree:airconditioner:502cc6XXXXXX:currentTemperature" }
Switch              AC1_Air                     "Air"                                           (groupItemAC1_room1)                                 { channel="gree:airconditioner:502cc6XXXXXX:air" }
Switch              AC1_Dry                     "Dry"                                           (groupItemAC1_room1)                                 { channel="gree:airconditioner:502cc6XXXXXX:dry" }
Switch              AC1_Turbo                   "Turbo"                                         (groupItemAC1_room1)                                 { channel="gree:airconditioner:502cc6XXXXXX:turbo" }
Number              AC1_WindSpeed               "Ventola [%d]"                                  (groupItemAC1_room1) ["Control"]                     { channel="gree:airconditioner:502cc6XXXXXX:windspeed" }
String              AC1_Quiet                   "Quiet"                         <text>          (groupItemAC1_room1)                                 { channel="gree:airconditioner:502cc6XXXXXX:quiet" }
Number              AC1_SwingUpDown             "Swing V [%d]"                                  (groupItemAC1_room1)                                 { channel="gree:airconditioner:502cc6XXXXXX:swingUpDown" }
Number              AC1_SwingLeftRight          "Swing H [%d]"                                  (groupItemAC1_room1)                                 { channel="gree:airconditioner:502cc6XXXXXX:swingLeftRight" }
Switch              AC1_PowerSave               "Power Save"                                    (groupItemAC1_room1)                                 { channel="gree:airconditioner:502cc6XXXXXX:powersave" }
Switch              AC1_Light                   "Display"                                       (groupItemAC1_room1)                                 { channel="gree:airconditioner:502cc6XXXXXX:light" }
Switch              AC1_Health                  "Health"                                        (groupItemAC1_room1)                                 { channel="gree:airconditioner:502cc6XXXXXX:health" }




