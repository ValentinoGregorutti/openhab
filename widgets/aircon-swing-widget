version: 1
widgets:
  aircon-swing-widget:
    tags: []
    props:
      parameters:
        - context: item
          description: Swing verticale (Number type)
          label: Item Verticale
          name: itemUpDown
          required: true
          type: TEXT
        - context: item
          description: Swing orizzontale (Number type)
          label: Item Orizzontale
          name: itemLeftRight
          required: true
          type: TEXT
    component: f7-block
    config:
      style:
        display: grid
        grid-template-columns: 1fr 1fr
        gap: 6px
        margin: 6px 0 0 0
        padding: 0
    slots:
      default:
        - component: oh-button
          config:
            action: options
            actionItem: =props.itemUpDown
            outline: false
            fill: false
            style:
              display: flex
              flex-direction: column
              align-items: center
              justify-content: center
              gap: 4px
              height: auto
              minHeight: 64px
              lineHeight: normal
              overflow: visible
              padding: 10px 4px
              border-radius: 10px
              background: rgba(120,120,120,0.08)
              white-space: normal
          slots:
            default:
              - component: Label
                config:
                  style:
                    fontSize: 11px
                    lineHeight: 1.3
                    opacity: 0.7
                    textAlign: center
                    width: 100%
                  text: Oscillazione su/giù
              - component: Label
                config:
                  style:
                    fontSize: 15px
                    lineHeight: 1.3
                    fontWeight: 600
                    textAlign: center
                    width: 100%
                  text: =items[props.itemUpDown].displayState
        - component: oh-button
          config:
            action: options
            actionItem: =props.itemLeftRight
            outline: false
            fill: false
            style:
              display: flex
              flex-direction: column
              align-items: center
              justify-content: center
              gap: 4px
              height: auto
              minHeight: 64px
              lineHeight: normal
              overflow: visible
              padding: 10px 4px
              border-radius: 10px
              background: rgba(120,120,120,0.08)
              white-space: normal
          slots:
            default:
              - component: Label
                config:
                  style:
                    fontSize: 11px
                    lineHeight: 1.3
                    opacity: 0.7
                    textAlign: center
                    width: 100%
                  text: Oscillazione destra/sinistra
              - component: Label
                config:
                  style:
                    fontSize: 15px
                    lineHeight: 1.3
                    fontWeight: 600
                    textAlign: center
                    width: 100%
                  text: =items[props.itemLeftRight].displayState
